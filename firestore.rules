rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a parent
    function isParent() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Don't allow user deletion via client
    }

    // Vocabulary cards - readable by all authenticated users, writable by parents only
    match /vocabularyCards/{cardId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isParent();
    }

    // User vocabulary progress - users can only read/write their own progress
    match /userVocabularyProgress/{progressId} {
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
    }

    // Quiz attempts - users can only read/write their own attempts
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
      allow delete: if false; // Don't allow deletion of quiz history
    }

    // Streaks - users can only read/write their own streaks
    match /streaks/{streakId} {
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
      allow delete: if false; // Don't allow deletion of streak history
    }

    // Reward rules - readable by all, writable only by parent who created them
    match /rewardRules/{ruleId} {
      allow read: if isAuthenticated();
      allow create: if isParent() &&
                      request.resource.data.parentId == request.auth.uid;
      allow update: if isParent() &&
                      resource.data.parentId == request.auth.uid;
      allow delete: if isParent() &&
                      resource.data.parentId == request.auth.uid;
    }

    // Rewards earned - users can read their own, parents can update to mark as paid
    match /rewardsEarned/{rewardId} {
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;
      // Allow parents to mark rewards as paid
      allow update: if isAuthenticated() && (
                      resource.data.userId == request.auth.uid ||
                      isParent()
                    );
      allow delete: if false; // Don't allow deletion of reward history
    }
  }
}
